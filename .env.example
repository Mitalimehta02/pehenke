# YouCam API key (V2). Server-side only: never prefix with NEXT_PUBLIC_.
# Create at https://yce.makeupar.com/api-console/en/api-keys/
YOUCAM_API_KEY=

# YouCam secret key. Optional: only for the older V1 token auth, used as a
# fallback if an endpoint (e.g. the unit balance) rejects the V2 API key.
YOUCAM_SECRET_KEY=

# YouCam API server (from the docs' OpenAPI `servers` entry)
YOUCAM_BASE_URL=https://yce-api-01.makeupar.com

# Render audit (optional). Gemini API key from Google AI Studio; the audit is
# skipped when empty. FREE TIER: Google may use inputs to improve its products,
# so only spike images, never real buyer photos (see CLAUDE.md).
GEMINI_API_KEY=
# Optional model override; default gemini-3.8-flash (checked against Google's docs)
GEMINI_MODEL=

# Hard cap on units the spike may spend in total (across all runs)
SPIKE_UNIT_CAP=300

# Postgres (Neon). Two strings from the Neon dashboard:
# POOLED ("-pooler" in the host): used by the app at runtime (lib/db.ts)
DATABASE_URL=
# DIRECT (same host without "-pooler"): used only by the Prisma CLI / migrations (prisma.config.ts)
DIRECT_URL=
