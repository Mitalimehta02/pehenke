{
  "name": "pehenke",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "next typegen && tsc --noEmit",
    "spike": "tsx --conditions=react-server scripts/spike/run.ts",
    "spike:costs": "tsx --conditions=react-server scripts/spike/costs.ts",
    "spike:skintone": "tsx --conditions=react-server scripts/spike/skintone.ts",
    "spike:recheck": "tsx --conditions=react-server scripts/spike/recheck.ts",
    "spike:audit": "tsx --conditions=react-server scripts/spike/audit.ts",
    "spike:report": "tsx --conditions=react-server scripts/spike/report.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@google/genai": "^2.27.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "prisma": "^7.10.0",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
